{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.1",
  "title": "Basic Exponent Rules",
  "semantics": {
    "Add": "openmath:arith1#plus",
    "Multiply": "openmath:arith1#times",
    "Power": "openmath:arith1#power"
  },
  "rules": [
    {
      "id": 1,
      "description": "Power of a power: (x^p)^q = x^(p*q) for integer powers",
      "pattern": [
        "Power",
        [
          "Power",
          "x_",
          "p_"
        ],
        "q_"
      ],
      "constraints": [
        [
          "IntegerQ",
          "p_"
        ],
        [
          "IntegerQ",
          "q_"
        ]
      ],
      "result": [
        "Power",
        "x_",
        [
          "Multiply",
          "p_",
          "q_"
        ]
      ],
      "comment": "Fundamental rule of exponents. Integer constraint prevents multivalued complex branches.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Algebra",
            "locator": "algebra:1-powers/1.1-basic-exponents:1"
          }
        ]
      }
    },
    {
      "id": 2,
      "description": "Product of powers: x^p * x^q = x^(p+q)",
      "pattern": [
        "Multiply",
        [
          "Power",
          "x_",
          "p_"
        ],
        [
          "Power",
          "x_",
          "q_"
        ]
      ],
      "constraints": [],
      "result": [
        "Power",
        "x_",
        [
          "Add",
          "p_",
          "q_"
        ]
      ],
      "comment": "Base must be strictly identical.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Algebra",
            "locator": "algebra:1-powers/1.1-basic-exponents:2"
          }
        ]
      }
    },
    {
      "id": 3,
      "description": "Identity power: x^1 = x",
      "pattern": [
        "Power",
        "x_",
        1
      ],
      "constraints": [],
      "result": "x_",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Algebra",
            "locator": "algebra:1-powers/1.1-basic-exponents:3"
          }
        ]
      }
    },
    {
      "id": 4,
      "description": "Zero power: x^0 = 1 for x != 0",
      "pattern": [
        "Power",
        "x_",
        0
      ],
      "constraints": [
        [
          "NonzeroQ",
          "x_"
        ]
      ],
      "result": 1,
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Algebra",
            "locator": "algebra:1-powers/1.1-basic-exponents:4"
          }
        ]
      }
    }
  ],
  "identity": "algebra:1-powers/1.1-basic-exponents"
}
