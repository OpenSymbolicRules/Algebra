{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "2.1",
  "title": "Basic Logarithm Rules",
  "semantics": {
    "Log": "openmath:transc1.ln",
    "Add": "openmath:arith1.plus",
    "Mul": "openmath:arith1.times",
    "Pow": "openmath:arith1.power",
    "is_positive": "local:predicate.is_positive"
  },
  "rules": [
    {
      "id": 1,
      "description": "Log of a product: log(a * b) = log(a) + log(b)",
      "pattern": ["Log", ["Mul", "~a", "~b"]],
      "constraints": [
        ["is_positive", "~a"],
        ["is_positive", "~b"]
      ],
      "result": ["Add", ["Log", "~a"], ["Log", "~b"]],
      "comment": "Requires positive arguments to avoid complex branches."
    },
    {
      "id": 2,
      "description": "Log of a power: log(a^b) = b * log(a)",
      "pattern": ["Log", ["Pow", "~a", "~b"]],
      "constraints": [
        ["is_positive", "~a"]
      ],
      "result": ["Mul", "~b", ["Log", "~a"]]
    }
  ]
}
