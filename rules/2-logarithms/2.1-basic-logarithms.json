{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "2.1",
  "title": "Basic Logarithm Rules",
  "semantics": {
    "Log": "openmath:transc1#ln",
    "Exp": "openmath:transc1#exp",
    "Add": "openmath:arith1#plus",
    "Multiply": "openmath:arith1#times",
    "Power": "openmath:arith1#power"
  },
  "rules": [
    {
      "id": 1,
      "description": "Log of a product: log(a * b) = log(a) + log(b)",
      "pattern": [
        "Log",
        [
          "Multiply",
          "a_",
          "b_"
        ]
      ],
      "constraints": [
        [
          "PositiveQ",
          "a_"
        ],
        [
          "PositiveQ",
          "b_"
        ]
      ],
      "result": [
        "Add",
        [
          "Log",
          "a_"
        ],
        [
          "Log",
          "b_"
        ]
      ],
      "comment": "Requires positive arguments to avoid complex branches.",
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Algebra",
            "locator": "algebra:2-logarithms/2.1-basic-logarithms:1"
          }
        ]
      }
    },
    {
      "id": 2,
      "description": "Log of a power: log(a^b) = b * log(a)",
      "pattern": [
        "Log",
        [
          "Power",
          "a_",
          "b_"
        ]
      ],
      "constraints": [
        [
          "PositiveQ",
          "a_"
        ]
      ],
      "result": [
        "Multiply",
        "b_",
        [
          "Log",
          "a_"
        ]
      ],
      "provenance": {
        "method": "authored",
        "sources": [
          {
            "name": "OpenSymbolicRules Algebra",
            "locator": "algebra:2-logarithms/2.1-basic-logarithms:2"
          }
        ]
      }
    },
    {
      "id": 3,
      "description": "Exponential and principal natural logarithm are inverse for nonzero complex arguments (Fungrim d87f6e).",
      "pattern": [
        "Exp",
        [
          "Log",
          "z_"
        ]
      ],
      "constraints": [
        [
          "NonzeroQ",
          "z_"
        ]
      ],
      "result": "z_",
      "provenance": {
        "method": "transcribed",
        "sources": [
          {
            "name": "Fungrim MathJSON",
            "locator": "corpus/log.json#d87f6e"
          }
        ]
      }
    }
  ],
  "identity": "algebra:2-logarithms/2.1-basic-logarithms"
}
