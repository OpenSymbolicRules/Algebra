{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "3.1",
  "title": "Polynomial Distribution",
  "semantics": {
    "Add": "openmath:arith1.plus",
    "Mul": "openmath:arith1.times"
  },
  "rules": [
    {
      "id": 1,
      "description": "Distribute multiplication over addition: a * (b + c) = a*b + a*c",
      "pattern": ["Mul", "~a", ["Add", "~b", "~c"]],
      "constraints": [],
      "result": ["Add", ["Mul", "~a", "~b"], ["Mul", "~a", "~c"]]
    }
  ]
}
