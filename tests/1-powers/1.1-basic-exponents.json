{
  "$schema": "open-symbolic-rules/v0.1",
  "section": "1.1",
  "title": "Basic Exponent Rules Tests",
  "tests": [
    {
      "id": 1,
      "expression": ["Power", ["Power", "x", 2], 3],
      "variable": "x",
      "expected_result": ["Power", "x", 6],
      "num_steps": 1,
      "grade": "A",
      "comment": "Rule 1: (x^2)^3 = x^6"
    },
    {
      "id": 2,
      "expression": ["Multiply", ["Power", "y", 2], ["Power", "y", 3]],
      "variable": "y",
      "expected_result": ["Power", "y", ["Add", 2, 3]],
      "num_steps": 1,
      "grade": "A",
      "comment": "Rule 2: y^2 * y^3 = y^(2+3), using integer exponents."
    },
    {
      "id": 3,
      "expression": ["Power", "z", 1],
      "variable": "z",
      "expected_result": "z",
      "num_steps": 1,
      "grade": "A",
      "comment": "Rule 3: z^1 = z"
    },
    {
      "id": 4,
      "expression": ["Power", "z", 0],
      "variable": "z",
      "expected_result": 1,
      "num_steps": 1,
      "grade": "A",
      "comment": "Rule 4: z^0 = 1 when z is nonzero"
    },
    {
      "id": 5,
      "expression": ["Power", "z", -1],
      "variable": "z",
      "expected_result": ["Divide", 1, "z"],
      "num_steps": 1,
      "grade": "A",
      "comment": "Rule 5: z^(-1) = 1/z when z is nonzero"
    },
    {
      "id": 6,
      "expression": ["Power", 1, "z"],
      "variable": "z",
      "expected_result": 1,
      "num_steps": 1,
      "grade": "A",
      "comment": "Rule 6: 1^z = 1"
    }
  ]
}
